    "binary": "build/bin/llama-completion",
    "runner": "ref",
    "compiler": "clang",
    "configure": ["cmake", "-B", "build", "-DCMAKE_BUILD_TYPE=Release", "-DBITNET_X86_TL2=OFF", "-DLLAMA_BUILD_COMMON=ON", "-DLLAMA_BUILD_TOOLS=ON", "-DLLAMA_BUILD_TESTS=OFF", "-DLLAMA_BUILD_EXAMPLES=OFF"],
    "targets": ["llama-completion"],
    "recorded_build": "Release, clang, BITNET_X86_TL2=OFF, i2_s"
