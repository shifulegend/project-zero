{
  "name": "project-zero-webui",
  "private": true,
  "version": "1.0.0",
  "description": "Web chat UI for project-zero's embedded HTTP API server (Phase 22.2). Built with Vite+Svelte at contributor time; the built dist/ is embedded into the C binary and committed, so end users never need Node.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --threshold warning",
    "test": "tsc -p tsconfig.test.json && node --test \"tests/*.test.mjs\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/*.mjs\" vite.config.js svelte.config.js",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/*.mjs\" vite.config.js svelte.config.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.14.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.1",
    "eslint": "9.14.0",
    "eslint-plugin-svelte": "2.46.0",
    "globals": "15.12.0",
    "prettier": "3.3.3",
    "prettier-plugin-svelte": "3.2.6",
    "svelte": "^4.2.19",
    "svelte-check": "^3.8.6",
    "typescript": "5.6.3",
    "typescript-eslint": "8.14.0",
    "vite": "^5.4.10"
  }
}
