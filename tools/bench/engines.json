    "runner": "cli",
    "configure": ["cmake", "-B", "build", "-DCMAKE_BUILD_TYPE=Release", "-DGGML_NATIVE=ON"],
    "targets": ["llama-cli", "llama-quantize"],
    "extra_binaries": {"quantize": "build/bin/llama-quantize"},
    "recorded_build": "Release, GGML_NATIVE=ON; -rtr on quantized models; BitNet converted I2_S -> IQ2_BN"
