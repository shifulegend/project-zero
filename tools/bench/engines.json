    "binary": "build/bin/llama-completion",
    "runner": "ref",
    "configure": ["cmake", "-B", "build", "-DCMAKE_BUILD_TYPE=Release", "-DGGML_NATIVE=ON"],
    "targets": ["llama-completion"],
    "recorded_build": "Release, GGML_NATIVE=ON"
  },
  "bitnetcpp": {
    "label": "bitnet.cpp",
    "repo": "https://github.com/microsoft/BitNet",
